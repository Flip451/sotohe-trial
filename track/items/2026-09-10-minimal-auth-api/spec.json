        }
      ],
      "id": "AC-003",
      "text": "A registered user's password is retained only as an argon2id hash, never in plaintext."
    }
  ],
  "constraints": [
    {
      "adr_refs": [
        {
          "anchor": "D2",
          "file": "knowledge/adr/2026-09-10-1126-minimal-auth-api.md"
        }
      ],
      "id": "CN-001",
      "text": "Passwords are never persisted in plaintext and are stored using argon2id hashing."
    },
    {
      "adr_refs": [
        {
          "anchor": "D3",
          "file": "knowledge/adr/2026-09-10-1126-minimal-auth-api.md"
        }
      ],
      "id": "CN-002",
      "text": "User and token persistence uses an in-memory implementation behind a repository port so it can be replaced later."
    },
    {
      "adr_refs": [
        {
          "anchor": "D4",
          "file": "knowledge/adr/2026-09-10-1126-minimal-auth-api.md"
        }
      ],
      "id": "CN-003",
      "text": "The HTTP surface is an axum REST API."
    },
    {
      "adr_refs": [
        {
          "anchor": "D4",
          "file": "knowledge/adr/2026-09-10-1126-minimal-auth-api.md"
        }
      ],
      "id": "CN-004",
      "text": "REST API requests use UTF-8 encoded JSON bodies. After UTF-8 decoding, JSON string values are used as received without Unicode normalization. A body with invalid UTF-8 or malformed JSON is rejected with HTTP 400, and a request with a media type other than application/json is rejected with HTTP 415."
    },
    {
      "adr_refs": [
        {
          "anchor": "D1",
          "file": "knowledge/adr/2026-09-10-1716-minimal-auth-empty-password-rejection.md"
        }
      ],
      "id": "CN-005",
      "text": "At the application boundary, registration and login reject a request whose presented password is empty."
    }
  ],
