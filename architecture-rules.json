{
  "version": 2,
  "module_limits": {
    "max_lines": 700,
    "warn_lines": 400,
    "exclude": ["vendor/", ".cache/", "target/", "tmp/"]
  },
  "canonical_modules": [],
  "extra_dirs": [
    {
      "path": "knowledge/conventions",
      "label": "project-specific engineering rules"
    },
    {
      "path": "track",
      "label": "track workflow state and planning artifacts"
    },
    {
      "path": "track/items/<id>",
      "label": "active track directory"
    },
    {
      "path": "track/archive/<id>",
      "label": "archived track directory"
    }
  ],
  "layers": [
    {
      "crate": "entities",
      "path": "libs/entities",
      "may_depend_on": [],
      "deny_reason": "Entities dependencies are controlled by layer boundaries.",
      "verify": {
        "domain_purity": true,
        "domain_strings": true
      },
      "tddd": {
        "enabled": true,
        "catalogue_file": "entities-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["entities"]
        }
      }
    },
    {
      "crate": "use_cases",
      "path": "libs/use_cases",
      "may_depend_on": [
        "entities"
      ],
      "verify": {
        "usecase_purity": true
      },
      "deny_reason": "Use_cases crate must only be consumed by the outer layers.",
      "tddd": {
        "enabled": true,
        "catalogue_file": "use_cases-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["use_cases"]
        }
      }
    },
    {
      "crate": "interface_adapters",
      "path": "libs/interface_adapters",
      "may_depend_on": [
        "use_cases"
      ],
      "deny_reason": "Interface adapters translate delivery inputs and invoke use-case ports.",
      "tddd": {
        "enabled": true,
        "catalogue_file": "interface_adapters-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["interface_adapters"]
        }
      }
    },
    {
      "crate": "frameworks",
      "path": "libs/frameworks",
      "may_depend_on": [
        "entities",
        "use_cases"
      ],
      "deny_reason": "Frameworks provide persistence, cryptography, and server-runtime adapters.",
      "tddd": {
        "enabled": true,
        "catalogue_file": "frameworks-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["frameworks"]
        }
      }
    },
    {
      "crate": "web_composition",
      "path": "apps/web-composition",
      "may_depend_on": [
        "entities",
        "use_cases",
        "frameworks",
        "interface_adapters"
      ],
      "deny_reason": "Web composition owns the complete object graph and server assembly.",
      "tddd": {
        "enabled": true,
        "catalogue_file": "web_composition-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["web_composition"],
          "notes": "[[bin]] target (crate-type bin); bin-target schema export is routed through the infrastructure schema_export path before invoking nightly rustdoc --output-format json"
        }
      }
    },
    {
      "crate": "web",
      "path": "apps/web",
      "may_depend_on": [
        "web_composition",
        "interface_adapters"
      ],
      "deny_reason": "Web is a thin binary entry point over web composition and interface adapters.",
      "tddd": {
        "enabled": true,
        "catalogue_file": "web-types.json",
        "catalogue_spec_signal": {
          "enabled": true
        },
        "schema_export": {
          "method": "rustdoc",
          "targets": ["web"]
        }
      }
    }
  ]
}
